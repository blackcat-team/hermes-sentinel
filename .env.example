# Hermes Sentinel — central service environment example (Stage E6).
#
# Synthetic placeholder values only. This file documents the exact
# variable names accepted by hermes_sentinel.settings.load_central_settings;
# it is example/documentation input only — the application has no dotenv
# runtime dependency. A real environment (or systemd EnvironmentFile) is
# supplied by the operator.
#
# --- non-secret central configuration -----------------------------------
# SQLite heartbeat database path (created by the application, not here).
SENTINEL_DATABASE_PATH=/var/lib/hermes-sentinel/heartbeats.db
# Plaintext heartbeat listen endpoint (no DNS resolution, no TLS here).
SENTINEL_LISTEN_HOST=127.0.0.1
SENTINEL_LISTEN_PORT=8080
# Runtime intervals, seconds (finite, strictly positive).
SENTINEL_MONITOR_INTERVAL_SECONDS=30
SENTINEL_POLL_INTERVAL_SECONDS=0.5
# Monitored host inventory (non-secret): JSON array, one object per host.
# Required per host: name, heartbeat, external. Optional: thresholds,
# services. No unknown or duplicate keys; no bool-as-number, numeric
# strings or NaN/Infinity values.
SENTINEL_HOSTS_JSON=[{"name":"vds-01","heartbeat":{"expected_interval_seconds":30,"stale_after_seconds":90},"external":{"tcp_host":"203.0.113.10","tcp_port":22,"timeout_seconds":5.0,"down_confirmations":3,"recovery_confirmations":2},"thresholds":{"cpu_percent":90,"ram_percent":90,"swap_percent":80,"disk_percent":85,"inode_percent":90,"load5_max":null},"services":[]}]
#
# --- reporter credential secrets -----------------------------------------
# One secret heartbeat token per configured host, JSON object
# node name -> token. The node set must match SENTINEL_HOSTS_JSON
# exactly; each host must have its own token. SECRET: never commit
# real values.
SENTINEL_NODE_TOKENS_JSON={"vds-01":"replace-with-vds-01-reporter-token"}
#
# --- Telegram bot-token secret (dedicated sender-only bot) ----------------
# SECRET: never commit real values.
SENTINEL_TELEGRAM_BOT_TOKEN=123456:REPLACE-WITH-BOT-TOKEN
SENTINEL_TELEGRAM_CHAT_ID=-1001234567890
# Optional (may be omitted entirely):
SENTINEL_TELEGRAM_MESSAGE_THREAD_ID=42
SENTINEL_TELEGRAM_TIMEOUT_SECONDS=10
